# ─────────────────────────────────────────────────────────────
# RABÉ – The Argie Experience · environment variables
# Copy to .env.local (local dev) or add in your host's dashboard
# (Vercel → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# Which AI to use: groq | gemini | anthropic | openai-compatible
# (leave empty to auto-pick whichever key is filled in)
LLM_PROVIDER=groq

# ── Groq (FREE, no credit card) — default ────────────────────
# Key: https://console.groq.com/keys
GROQ_API_KEY=
# Smartest free model first; falls back automatically when rate-limited.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Photo reading (vision) and memory use Groq too. Defaults are fine.
# VISION_MODEL=qwen/qwen3.8-27b
# MEMORY_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Let RABÉ search the web for current info (true/false)
ENABLE_WEB_SEARCH=true

# ── Google Gemini (free tier on eligible Google projects) ────
# Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# ── Claude (paid) ────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# ── Passcode lock ────────────────────────────────────────────
# Only Rabe uses this app. Set a passcode to lock everything (chat, history,
# photos). Leave empty for no lock. Changing it signs out every device.
APP_PASSCODE=
# Optional extra secret mixed into the session cookie (any long random text).
# AUTH_SECRET=

# ── Database ─────────────────────────────────────────────────
# Postgres connection string (Neon free tier: https://neon.tech).
# Leave empty for local development → chats saved to .data/rabe-db.json
DATABASE_URL=

# Max chat messages per visitor per 5 minutes
RATE_LIMIT_PER_5_MIN=30
